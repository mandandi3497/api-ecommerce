{
    "info": {
        "name": "API E-commerce",
        "description": "Colección de Postman para probar los endpoints de la API de la tienda online.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Crear producto",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"nombre\": \"Teclado inalámbrico Logitech\",\n    \"descripcion\": \"Teclado inalámbrico para ordenador\",\n    \"precio\": 39.99,\n    \"stock\": 10\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "http://localhost:3000/products"
            }
        },
        {
            "name": "Listar productos",
            "request": {
                "method": "GET",
                "header": [],
                "url": "http://localhost:3000/products"
            }
        },
        {
            "name": "Agregar producto al carrito",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"productoId\": \"ID_DEL_PRODUCTO\",\n    \"cantidad\": 2\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "http://localhost:3000/cart"
            }
        },
        {
            "name": "Consultar carrito",
            "request": {
                "method": "GET",
                "header": [],
                "url": "http://localhost:3000/cart"
            }
        },
        {
            "name": "Realizar checkout",
            "request": {
                "method": "POST",
                "header": [],
                "url": "http://localhost:3000/checkout"
            }
        }
    ]
